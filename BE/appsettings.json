{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AssetConfiguration": {
        "IconsPath": "assets/icons/",
        "BodySystemIconPath": "assets/bodySys/",
        "DefaultBodySystemIconPath": ["assets", "bodySys", "cardiovascular.png"],
        "DefaultOrganIconPath": ["assets", "icons", "brain.svg"],
        "GeoJsonPath": "assets/geojson/",
        "SampleImagesPath": "/media/wsi",
        "PdfsPath": "/media/pdfs"
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "WebApiDatabase": "Host=postgres; Port=5432; Database=postgres; Username=postgres; Password=postgres"
    },
  "TusConfig": {
    "UploadUrl": "admin/upload-sample-image",
    "UploadPath": "assets/uploads",
    "Expiration": 15.0,
    "DbCleanupInterval": 5.0,
    "EnableOnAuthorize": true,
    "RecognizedExtensions": [ "*.vsi", "*.bif", "*.svs", "*.tif", "*.tiff", "*.mrxs", "*.ndpi" ]
  },
  "TableParsing": {
    "StudentImport": {
      "ColumnMap": {
        "0": "FirstName",
        "1": "LastName",
        "2": "FullName",
        "10": "Email",
        "5": "Year",
        "7": "Program",
        "6": "Group"
      },
      "DataStartRow": 9
    },
    "BulkUpload": {
      "ColumnMap": {
        //TODO!
        "0": "ItemName",
        "1": "Category",
        "2": "Description"
      },
      "DataStartRow": 2
    }
  }
}
