  "home": {
    "title": "Histological atlas",
    "content": "Content",
    "addsamplebutton": "Add new sample",
    "welcomeMessage": {
      "paragraph1": "Welcome to our website, where we have created a unique histopathological atlas. Histopathology is a fascinating field that deals with the study of tissues and cells and their pathological changes. Our goal is to provide professionals, students, and medical enthusiasts with access to a rich source of images and information that will help them better understand various histological findings.",
      "paragraph2": "Our atlas contains a wide range of histopathological cases, covering various organs and tissues. Each case is thoroughly documented, with high-quality images and a description of histological characteristics. We believe that this atlas will be a useful tool for education, research, and diagnostics in the field of histopathology."
    },
